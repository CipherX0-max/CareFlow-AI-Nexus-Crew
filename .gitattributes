# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# Web / Frontend
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.mjs text eol=lf

# Config / Docs
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.mako text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.webm binary
*.m4a binary
*.webp binary
*.db binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
