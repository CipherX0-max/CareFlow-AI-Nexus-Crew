# ============================================================================
# CareFlow AI - environment template. Copy to .env. Placeholders only: never commit real secrets.
# ============================================================================
APP_ENV=development                      # development | production
SECRET_KEY=change-me-development-only    # production: `openssl rand -hex 32` (>=32 chars) - required
DATABASE_URL=sqlite:///./data/careflow.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/careflow   (install psycopg2; add append-only triggers, see README)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# --- web security ---
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false                      # must be true behind HTTPS (required in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
EXPOSE_DEV_TOKENS=true                   # dev only: returns email-verification / password-reset tokens in the API response (no email service). Refused in production.

# --- local LLM (Ollama, backend only; no cloud fallback exists) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
LLM_ENABLED=true
LLM_CONFLICT_OPINIONS=false              # advisory LLM commentary on conflicts (never resolves them)

# --- local speech-to-text (faster-whisper) ---
WHISPER_MODEL=small                      # tiny | base | small | medium | large-v3  (multilingual)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LOCAL_ONLY=false                 # true = never download models
STT_ENABLED=true

# --- OCR ---
TESSERACT_CMD=                           # empty = autodetect on PATH
TESSERACT_LANGS=eng+hin
TESSDATA_DIR=./data/tessdata             # folder containing eng/hin/osd .traineddata
OCR_MIN_CONFIDENCE=60

# --- limits ---
MAX_UPLOAD_MB=20
MAX_AUDIO_MB=25
MAX_PDF_PAGES=20
MAX_AUDIO_SECONDS=300

# --- safety text ---
EMERGENCY_NUMBER=                        # your locally configured emergency number, shown in the emergency warning (clinician-reviewed)
RULES_PATH=./backend/careflow/rules/demo_ruleset.json
KNOWLEDGE_PATH=./backend/careflow/rules/demo_knowledge.json
